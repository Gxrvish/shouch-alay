# Copy to .env.local for local development (`vercel env pull` writes the same file).
# On Vercel, set these under Project Settings → Environment Variables.

# --- Required ------------------------------------------------------------------------------
# Neon: `neon env pull` writes both. The app uses the pooled one (host contains "-pooler");
# `npm run migrate` uses the direct one when set.
# Local Postgres over a Unix socket: postgresql:///loo_queue?host=/var/run/postgresql
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Signs session cookies; at least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=
# Google OAuth client of type "Web application". Authorized redirect URI: <BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel Cron sends it as a Bearer token to /api/cron/tick. Generate: openssl rand -hex 24
CRON_SECRET=

# --- Usually set -----------------------------------------------------------------------------
# Public URL. Defaults to the Vercel production domain, or http://localhost:3000 locally.
# BASE_URL=https://loo.example.com
# Comma-separated. Admins can add, rename, close and reopen toilets. Nothing else.
ADMIN_EMAILS=
# Web Push. Generate a key pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:facilities@odoo.com

# --- Timeouts in seconds (defaults shown) ----------------------------------------------------
# Time a notified user has to tap "I'm going in".
CLAIM_WINDOW_SEC=120
# Time inside before "Are you still there?".
MAX_OCCUPANCY_SEC=900
# Time to answer "Are you still there?" before the toilet is released.
GRACE_SEC=120
# Hard limit on one visit; "I'm still here" cannot extend past it.
MAX_STAY_SEC=1800

# --- Optional email fallback, used only when push cannot be delivered -------------------------
EMAIL_NOTIFICATIONS=false
# SMTP_URL=smtps://user:password@smtp-relay.gmail.com:465
# EMAIL_FROM=Loo Queue <noreply@odoo.com>

# --- Local development only: password-less sign-in under `npm run dev` ------------------------
# Ignored by production builds, so it is harmless if it leaks into Vercel settings.
DEV_LOGIN=1
