{
  "name": "loo-queue",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sw && next dev",
    "build": "npm run sw && next build",
    "start": "next start",
    "sw": "tsc -p sw",
    "typecheck": "tsc --noEmit && tsc -p sw --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.4",
    "jose": "^6.2.14",
    "next": "^16.4.3",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
